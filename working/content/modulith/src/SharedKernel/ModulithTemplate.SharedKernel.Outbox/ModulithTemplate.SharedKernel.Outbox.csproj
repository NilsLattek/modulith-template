<Project Sdk="Microsoft.NET.Sdk">

  <!-- Owns the shared outbox table: its DbContext, its migrations, and nothing else. Separate from
       Shared.Infrastructure so that project keeps its "EF conventions only, never a concrete
       DbContext" charter, and so the outbox package stays out of every feature's Contracts. -->
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Underground.Outbox" />
  </ItemGroup>

</Project>
