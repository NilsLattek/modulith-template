@using ModulithTemplate.Features.Orders.Application.Queries.GetSomeEntityCount
@using ModulithTemplate.Features.Orders.Application.Commands.AddSomeEntity

@inject IScopedMediator Mediator

<h2>Orders</h2>

@if (_failed)
{
    <p class="text-danger">
        Could not read the Orders schema. Create and apply its migrations first:
        <code>bash add-migration.sh Orders InitialOrders</code> <br />
        <code>bash add-migration.sh Payments InitialPayments</code> <br />
        <code>bash add-migration.sh Outbox SetupOutbox</code> <br /> then <code>bash update-database.sh</code>.
    </p>
}
else if (_count is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <p>Entities recorded (it will not refresh automatically right now): <strong>@_count</strong></p>
}

<button @onclick="AddClicked">Add</button>

@code {
    private int? _count;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        // IScopedMediator, never a directly injected IMediator: it gives the message a DI scope of
        // its own, so the handler's DbContext lives and dies with it. Redundant under this page's
        // static SSR, but the moment the component turns interactive one DbContext would otherwise
        // stay open for the whole circuit.
        var result = await Mediator.Send(new GetSomeEntityCountQuery());

        if (result.IsSuccess)
        {
            _count = result.Value;
        }
        else
        {
            // On a fresh scaffold the one likely failure is the missing table; the pipeline's
            // ExceptionBehaviour has already logged the real exception.
            _failed = true;
        }
    }

    private async Task AddClicked()
    {
        await Mediator.Send(new AddSomeEntityCommand("Test", 1));
    }
}
