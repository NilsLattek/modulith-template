@using ModulithTemplate.Features.Orders.Application.Queries.GetSomeEntityCount

@inject IScopedMediator Mediator

<h2>Orders</h2>

@if (_failed)
{
    <p class="text-danger">
        Could not read the Orders schema. Create and apply its migrations first:
        <code>bash add-migration.sh Orders InitialOrders</code> <br />
        <code>bash add-migration.sh Payments InitialPayments</code> <br />
        <code>bash add-migration.sh Outbox SetupOutbox</code> <br /> then <code>bash update-database.sh</code>.
    </p>
}
else if (_count is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <p>Entities recorded: <strong>@_count</strong></p>
}

<AddSomeEntityForm OnAdded="LoadCountAsync" />

@code {
    private int? _count;
    private bool _failed;

    protected override Task OnInitializedAsync() => LoadCountAsync();

    private async Task LoadCountAsync()
    {
        // IScopedMediator, never a directly injected IMediator: the app renders interactively, so an
        // injected scoped service lives for the whole circuit, and one DbContext with it.
        var result = await Mediator.Send(new GetSomeEntityCountQuery());

        // On a fresh scaffold the one likely failure is the missing table; the pipeline's
        // ExceptionBehaviour has already logged the real exception.
        _failed = result.IsFailed;
        _count = result.IsSuccess ? result.Value : null;
    }
}
