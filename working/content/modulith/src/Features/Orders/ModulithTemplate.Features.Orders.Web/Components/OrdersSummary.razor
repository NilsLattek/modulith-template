@using ModulithTemplate.Features.Orders.Application.Queries.GetSomeEntityCount

@inject IScopedMediator Mediator

<h2>Orders</h2>

@if (_failed)
{
    <p class="text-danger">
        Could not read the Orders schema. Create and apply its migrations first:
        <code>bash add-migration.sh Orders InitialOrders</code> <br />
        <code>bash add-migration.sh Payments InitialPayments</code> <br />
        <code>bash add-migration.sh Outbox SetupOutbox</code> <br /> then <code>bash update-database.sh</code>.
    </p>
}
else if (_count is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <p>Entities recorded: <strong>@_count</strong></p>

    <EditForm Model="_form" OnValidSubmit="AddAsync" FormName="add-some-entity">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="_form.Name" />
            <ValidationMessage For="() => _form.Name" />
        </div>

        <div class="mb-3">
            <label for="amount" class="form-label">Amount</label>
            <InputNumber id="amount" class="form-control" @bind-Value="_form.Amount" step="0.01" />
            <ValidationMessage For="() => _form.Amount" />
        </div>

        @if (_submitError is not null)
        {
            <p class="text-danger">@_submitError</p>
        }

        <button type="submit" class="btn btn-primary" disabled="@_submitting">Add</button>
    </EditForm>
}

@code {
    private AddSomeEntityForm _form = new();
    private int? _count;
    private bool _failed;
    private bool _submitting;
    private string? _submitError;

    protected override Task OnInitializedAsync() => LoadCountAsync();

    private async Task LoadCountAsync()
    {
        // IScopedMediator, never a directly injected IMediator: it gives the message a DI scope of
        // its own, so the handler's DbContext lives and dies with it rather than with the circuit.
        var result = await Mediator.Send(new GetSomeEntityCountQuery());

        if (result.IsSuccess)
        {
            _count = result.Value;
        }
        else
        {
            // On a fresh scaffold the one likely failure is the missing table; the pipeline's
            // ExceptionBehaviour has already logged the real exception.
            _failed = true;
        }
    }

    private async Task AddAsync()
    {
        _submitting = true;
        _submitError = null;

        try
        {
            var result = await Mediator.Send(_form.ToCommand());

            if (result.IsSuccess)
            {
                _form = new AddSomeEntityForm();
                await LoadCountAsync();
            }
            else
            {
                _submitError = "The entity could not be added.";
            }
        }
        finally
        {
            _submitting = false;
        }
    }
}
