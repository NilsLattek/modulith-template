<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Orders feature's published contract: the only project of this feature that another
       feature may reference. It deliberately references nothing but Shared.Application — adding a
       reference to this feature's Domain, Application, Infrastructure or Web would turn the
       contract into a back door into the module, and ContractIsolationTests fails the build if
       one appears. -->
  <ItemGroup>
    <ProjectReference Include="../../../SharedKernel/ModulithTemplate.SharedKernel.Application/ModulithTemplate.SharedKernel.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Api/" />
  </ItemGroup>

</Project>
