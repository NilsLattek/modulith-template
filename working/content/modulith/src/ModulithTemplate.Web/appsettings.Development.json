{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // The search path is load-bearing, not cosmetic: the outbox library's claim SQL names its table
    // unqualified ("FROM outbox"), so it resolves only through the search path. Feature tables stay
    // schema-qualified by their own contexts and are unaffected. public stays on the path so
    // extensions installed there (pgcrypto, uuid-ossp) remain reachable unqualified.
    "PostgresConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres;Search Path=shared,public"
  }
}
