@using ModulithTemplate.Features.Orders.Application.Queries.GetSomeEntityCount

@inject IServiceScopeFactory ScopeFactory

<h2>Orders</h2>

@if (_failed)
{
    <p class="text-danger">
        Could not read the Orders schema. Create and apply its migrations first:
        <code>bash add-migration.sh Orders InitialOrders</code> then <code>bash update-database.sh</code>.
    </p>
}
else if (_count is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <p>Entities recorded: <strong>@_count</strong></p>
}

@code {
    private int? _count;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        // One DI scope per operation, so the handler's DbContext lives and dies with the message.
        // Redundant under this page's static SSR, but the moment the component turns interactive a
        // directly injected IMediator would hold one DbContext open for the whole circuit.
        var result = await ScopeFactory.WithNewScopeAsync(services =>
            services.GetRequiredService<IMediator>()
                .Send(new GetSomeEntityCountQuery(), CancellationToken.None));

        if (result.IsSuccess)
        {
            _count = result.Value;
        }
        else
        {
            // On a fresh scaffold the one likely failure is the missing table; the pipeline's
            // ExceptionBehaviour has already logged the real exception.
            _failed = true;
        }
    }
}
