<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="FluentResults" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- The handler interface, and the generator that emits this assembly's
         AddModulithTemplateFeaturesPaymentsApplicationMessageHandlers(). Scaffolded before this
         feature publishes anything, so its first Integration Event costs no csproj edit. -->
    <PackageReference Include="Underground.Outbox" />
    <PackageReference Include="Underground.Outbox.SourceGenerator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../SharedKernel/ModulithTemplate.SharedKernel.Application/ModulithTemplate.SharedKernel.Application.csproj" />
    <!-- A sibling feature's published contract, and the only part of Orders this feature may see.
         Application is the one layer allowed to reference a Contracts project. -->
    <ProjectReference Include="../../Orders/ModulithTemplate.Features.Orders.Contracts/ModulithTemplate.Features.Orders.Contracts.csproj" />
    <ProjectReference Include="../ModulithTemplate.Features.Payments.Contracts/ModulithTemplate.Features.Payments.Contracts.csproj" />
    <ProjectReference Include="../ModulithTemplate.Features.Payments.Domain/ModulithTemplate.Features.Payments.Domain.csproj" />
  </ItemGroup>

</Project>
